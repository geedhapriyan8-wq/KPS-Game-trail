rules_version = '2';

// ════════════════════════════════════════════════════════════════
// Firestore security rules for the KPS project template.
//
// Quick reference:
//
//   completions  — public read, anyone signed in can create
//   surveys      — admin read only, anyone signed in can create
//   admins       — owner-only read, no client writes (admin adds via console)
//
// Deploy with: npx firebase deploy --only hosting,firestore:rules
// Or just the rules: npx firebase deploy --only firestore:rules
// Local dev talks to real Firebase, so the same rules apply in dev and prod.
// ════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // Game completions — written by kids after finishing the activity.
    // Public read so the passcode screen can show a live count.
    // Data should stay anonymous (no personal info).
    match /completions/{docId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }

    // Survey responses — admin-only read since responses may identify users.
    // Anyone signed in can submit one.
    match /surveys/{docId} {
      allow read: if isAdmin();
      allow create: if request.auth != null
                    && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }

    // Admin whitelist — doc ID is the admin's Firebase Auth UID.
    // Existence of the doc grants admin permission. Each admin can read
    // their own doc to confirm membership at sign-in time.
    // Add new admins via the Firebase Console (Firestore → admins → add doc).
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
  }
}
